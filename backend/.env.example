# Backend development environment — safe defaults for the Docker Compose stack.
# Copy to backend/.env before running `pnpm run dev`.

NODE_ENV=development
LOG_LEVEL=debug

# UnoPim local development only. Allows media downloads over HTTP and from a
# private/loopback address, while still pinning every request to the configured
# UnoPim baseUrl host. The backend refuses this value outside NODE_ENV=development.
UNOPIM_ALLOW_INSECURE_MEDIA_HTTP=1

# HTTP
# PORT — port the Fastify dev server listens on. Loaded from this .env via
# `tsx --env-file-if-exists=.env` in package.json's `dev` script.
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
# Which upstream proxy may be believed about the client address (issue #220).
# Unset in development — nothing sits in front of the dev server, so the socket
# peer IS the client. A deployment behind a reverse proxy sets exactly one of:
#   TRUSTED_PROXY_HOPS=1          # number of proxies in front of the backend
#   TRUSTED_PROXY_ADDRESSES=...   # their IPs / CIDRs, or loopback|linklocal|uniquelocal
# See deploy/README.md. There is no value meaning "trust any hop".

# PostgreSQL (docker-compose: postgres service)
DATABASE_URL=postgresql://b2b:b2b@localhost:5432/b2b

# Redis (docker-compose: redis service) — used for cache + BullMQ queues
REDIS_URL=redis://localhost:6379

# Meilisearch (docker-compose: meilisearch service)
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=devMasterKeyChangeMe

# Mailer — production-style URL used by composition.ts when set (verification + invitations)
# Example Mailhog: SMTP_URL=smtp://localhost:1025
# SMTP_FROM=no-reply@localhost
SMTP_URL=

# Legacy explicit SMTP fields (optional if not using SMTP_URL)
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@localhost

# Public backend origin for absolute asset URLs in outbound emails
# (Mail clients cannot load host-relative `/assets/file/...` paths).
BACKEND_PUBLIC_URL=http://localhost:3001

# Session cookie signing key — generate a new one per environment with `openssl rand -hex 32`
SESSION_COOKIE_SECRET=change-me-in-real-deployments

# Assets Library (feature 013) — HMAC key used by the Local FS storage adapter
# to sign short-lived URLs for `private`-visibility assets served from
# `/assets/file/:assetId?token=&exp=`. Generate per environment with
# `openssl rand -hex 32`. Cloud adapters (S3, GCS) use their own native signed
# URLs and ignore this key. Rotating invalidates every outstanding private URL.
ASSETS_LIBRARY_HMAC_KEY=change-me-in-real-deployments

# Sales Channels (feature 005) — both optional.
# DEFAULT_SALES_CHANNEL_CODE: code of the channel that backend boot reconciles
# as `system_default = true`. If unset, defaults to `default`.
DEFAULT_SALES_CHANNEL_CODE=default
# SALES_CHANNEL_HOST_MAP: host-based resolver map used by the storefront/POS
# resolver middleware when no `X-Sales-Channel` header is provided. Comma-
# separated list of `host=channelCode` pairs. Empty string disables host
# resolution. Example: SALES_CHANNEL_HOST_MAP=serwisA.com=channel-a,serwisB.com=channel-b
SALES_CHANNEL_HOST_MAP=

# --- MFA module (feature 042) ---
# base64-encoded 32-byte AES key for encrypting TOTP secrets at rest (required for 2FA enrolment)
MFA_SECRET_ENCRYPTION_KEY=
# Federated sign-in (optional — OAuth routes register only when a provider is configured)
MFA_OAUTH_GOOGLE_CLIENT_ID=
MFA_OAUTH_GOOGLE_CLIENT_SECRET=
MFA_OAUTH_MICROSOFT_CLIENT_ID=
MFA_OAUTH_MICROSOFT_CLIENT_SECRET=
MFA_OAUTH_MICROSOFT_TENANT=common
# Public base URLs used to build OAuth redirect_uri + post-login redirects
BACKEND_PUBLIC_URL=http://localhost:3001
ADMIN_BASE_URL=http://localhost:3002

# Public API origin for inbound provider callbacks (TPay / PayU / Autopay ITN, etc.),
# public product-feed URLs and newsletter confirmation links. BACKEND_PUBLIC_URL above is
# read as a synonym, and in NODE_ENV=production the backend refuses to boot if neither is
# set — it used to default to http://localhost:3001, which silently broke every payment.
# Localhost is unreachable from payment gateways — use an HTTPS tunnel in development, e.g.
#   cloudflared tunnel --url http://localhost:3001
# PUBLIC_API_BASE_URL=https://….trycloudflare.com
# PUBLIC_API_BASE_URL=
# Autopay ITN URL (configure in Autopay portal): {PUBLIC_API_BASE_URL}/api/v1/autopay/itn
# Autopay ISTN URL (panel refunds/settlements — ask Autopay to enable): {PUBLIC_API_BASE_URL}/api/v1/autopay/istn

# --- Settings 'secret' value type (feature 043) ---
# base64-encoded 32-byte AES key for encrypting secret settings at rest
# (e.g. prompt_actions.api_key). Generate with: openssl rand -base64 32
SETTINGS_SECRET_ENCRYPTION_KEY=
STOREFRONT_BASE_URL=http://localhost:3000
REVALIDATE_SECRET=change-me-shared-with-storefront

# --- Local HTTPS upstreams signed by a private CA (Warden) ---
# Node builds its CA store from this variable at startup and ignores the system
# store, so an outbound fetch to an https://*.test host — a Pimcore or Magento
# fixture in another Warden environment — fails UNABLE_TO_VERIFY_LEAF_SIGNATURE
# even though curl on the same machine succeeds. Point it at the Warden root CA.
# NODE_EXTRA_CA_CERTS=/home/<user>/.warden/ssl/rootca/certs/ca.cert.pem
