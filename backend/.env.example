# Backend development environment — safe defaults for the Docker Compose stack.
# Copy to backend/.env before running `pnpm run dev`.

NODE_ENV=development
LOG_LEVEL=debug

# HTTP
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# PostgreSQL (docker-compose: postgres service)
DATABASE_URL=postgresql://b2b:b2b@localhost:5432/b2b

# Redis (docker-compose: redis service) — used for cache + BullMQ queues
REDIS_URL=redis://localhost:6379

# Meilisearch (docker-compose: meilisearch service)
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=devMasterKeyChangeMe

# Mailer — production-style URL used by composition.ts when set (verification + invitations)
# Example Mailhog: SMTP_URL=smtp://localhost:1025
# SMTP_FROM=no-reply@localhost
SMTP_URL=

# Legacy explicit SMTP fields (optional if not using SMTP_URL)
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@localhost

# Session cookie signing key — generate a new one per environment with `openssl rand -hex 32`
SESSION_COOKIE_SECRET=change-me-in-real-deployments
