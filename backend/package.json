{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "B2B platform backend \u2014 Fastify API server. Owns every business module, migrations, and tests.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "acceptance:package-schema": "tsx scripts/acceptance/package-schema.ts",
    "acceptance:package-schema:ci": "tsx scripts/acceptance/package-schema.ts --against-expectation",
    "admin:create": "tsx --env-file-if-exists=.env src/cli.ts admin_users create",
    "audit:read": "tsx --env-file-if-exists=.env src/cli.ts audit_logs read",
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-runtime-assets.ts",
    "cache:clear": "tsx --env-file-if-exists=.env src/cli.ts settings cache-clear",
    "cart:abandonment-sweep": "tsx --env-file-if-exists=.env src/cli.ts carts abandonment-sweep",
    "channel:resolution": "tsx scripts/check-channel-resolution.ts",
    "check:action-route-permissions": "tsx scripts/check-action-route-permissions.ts",
    "check:admin-registrations": "tsx scripts/check-admin-registrations.ts",
    "check:admin-surface": "tsx scripts/check-admin-surface.ts",
    "check:admin-zones": "tsx scripts/check-admin-zones.ts",
    "check:bundle-pairing": "tsx scripts/check-bundle-pairing.ts",
    "check:command-coverage": "tsx scripts/check-command-coverage.ts",
    "check:container-imports": "tsx scripts/check-container-imports.ts",
    "check:default-language-prose": "tsx scripts/check-default-language-prose.ts",
    "check:diacritic-folds": "tsx scripts/check-diacritic-folds.ts",
    "check:doc-snippets": "tsx scripts/check-doc-snippets.ts",
    "check:entry-presence": "tsx scripts/check-entry-presence.ts",
    "check:entry-scope": "tsx scripts/check-entry-scope.ts",
    "check:error-translations": "tsx scripts/check-error-translations.ts",
    "check:fixture-substitution": "tsx scripts/check-fixture-substitution.ts",
    "check:harness-teardown": "tsx scripts/check-harness-teardown.ts",
    "check:kernel-boundary": "tsx scripts/check-kernel-boundary.ts",
    "check:lock-claims": "tsx scripts/check-lock-claims.ts",
    "check:module-boundary": "tsx scripts/check-module-boundary.ts",
    "check:nul-bytes": "tsx scripts/check-nul-bytes.ts",
    "check:platform-surface": "tsx scripts/check-platform-surface.ts",
    "check:port-catches": "tsx scripts/check-port-catches.ts",
    "check:port-dependencies": "tsx scripts/check-port-dependencies.ts",
    "check:port-shape": "tsx scripts/check-port-shape.ts",
    "check:release-intent": "tsx scripts/check-release-intent.ts",
    "check:shared-table-wipes": "tsx scripts/check-shared-table-wipes.ts",
    "check:singleton-identity": "tsx scripts/check-singleton-identity.ts",
    "check:subscribe-seam": "tsx scripts/check-subscribe-seam.ts",
    "check:transaction-context": "tsx scripts/check-transaction-context.ts",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "composer:check": "tsx scripts/generate-composer.ts --check",
    "composer:generate": "tsx scripts/generate-composer.ts",
    "db:fresh": "tsx --env-file-if-exists=.env src/db/migrate.ts fresh",
    "db:reset": "pnpm run db:fresh && pnpm run seed:dev",
    "dev": "node scripts/dev.mjs src/index.ts",
    "i18n:coverage": "tsx --env-file-if-exists=.env src/cli.ts _i18n coverage",
    "i18n:hardcoded": "tsx scripts/i18n-hardcoded-strings.ts",
    "i18n:reload": "tsx --env-file-if-exists=.env src/cli.ts _i18n reload",
    "lint": "eslint src test",
    "manifest-index:generate": "tsx scripts/generate-composer.ts",
    "manifests:check": "tsx scripts/generate-module-manifests.ts --check",
    "manifests:generate": "tsx scripts/generate-module-manifests.ts",
    "migration:down": "tsx --env-file-if-exists=.env src/db/migrate.ts down",
    "migration:new": "tsx scripts/new-migration.ts",
    "migration:pending": "tsx --env-file-if-exists=.env src/db/migrate.ts pending",
    "migration:up": "tsx --env-file-if-exists=.env src/db/migrate.ts up",
    "module:disable": "tsx --env-file-if-exists=.env src/lifecycle/scripts/disable.ts",
    "module:enable": "tsx --env-file-if-exists=.env src/lifecycle/scripts/enable.ts",
    "module:install": "tsx --env-file-if-exists=.env src/lifecycle/scripts/install.ts",
    "module:status": "tsx --env-file-if-exists=.env src/lifecycle/scripts/status.ts",
    "module:uninstall": "tsx --env-file-if-exists=.env src/lifecycle/scripts/uninstall.ts",
    "overlay:check": "tsx scripts/check-overlay-determinism.ts",
    "overlay:manifest": "tsx scripts/generate-override-manifest.ts",
    "search:reindex": "tsx --env-file-if-exists=.env src/cli.ts search reindex",
    "seed:dev": "pnpm run migration:up && tsx --env-file-if-exists=.env src/seeds/dev-catalog-seed.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:contract": "vitest run test/contract",
    "test:integration": "vitest run test/integration",
    "test:perf": "PERF_RUN=true vitest run test/perf",
    "test:release-gate": "vitest run --config vitest.release.config.ts",
    "test:unit": "vitest run test/unit",
    "test:unit:fast": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "worker": "node dist/worker.js",
    "worker:dev": "node scripts/dev.mjs src/worker.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-s3": "^3.1042.0",
    "@aws-sdk/s3-request-presigner": "^3.1042.0",
    "@endora-commerce/cms-components": "workspace:^",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/email-components": "workspace:^",
    "@endora-commerce/mod-addresses": "workspace:*",
