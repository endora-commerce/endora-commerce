    "esbuild": "^0.27.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/db/mikro-orm.config.ts",
      "./dist/db/mikro-orm.config.js"
    ]
  }
