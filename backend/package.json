{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "B2B platform backend — Fastify API server. Owns every business module, migrations, and tests.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "pnpm run manifest-index:generate && tsc -p tsconfig.build.json",
    "manifest-index:generate": "tsx scripts/generate-manifest-index.ts",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:contract": "vitest run test/contract",
    "test:integration": "vitest run test/integration",
    "test:perf": "PERF_RUN=true vitest run test/perf",
    "migration:up": "tsx --env-file-if-exists=.env src/db/migrate.ts up",
    "migration:down": "tsx --env-file-if-exists=.env src/db/migrate.ts down",
    "migration:pending": "tsx --env-file-if-exists=.env src/db/migrate.ts pending",
    "db:fresh": "tsx --env-file-if-exists=.env src/db/migrate.ts fresh",
    "db:reset": "pnpm run db:fresh && pnpm run seed:dev",
    "seed:dev": "pnpm run migration:up && tsx --env-file-if-exists=.env src/modules/catalog/seeds/dev-catalog-seed.ts",
    "search:reindex": "tsx --env-file-if-exists=.env src/modules/search/scripts/reindex.ts",
    "cart:abandonment-sweep": "tsx --env-file-if-exists=.env src/modules/carts/scripts/abandonment-sweep.ts",
    "cache:clear": "tsx --env-file-if-exists=.env src/modules/settings/scripts/cache-clear.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/modules/admin_users/scripts/create-admin.ts",
    "modules:install": "tsx --env-file-if-exists=.env src/modules/settings/scripts/modules-install.ts",
    "modules:uninstall": "tsx --env-file-if-exists=.env src/modules/settings/scripts/modules-uninstall.ts",
    "module:install": "tsx --env-file-if-exists=.env src/modules/_lifecycle/scripts/install.ts",
    "module:uninstall": "tsx --env-file-if-exists=.env src/modules/_lifecycle/scripts/uninstall.ts",
    "module:enable": "tsx --env-file-if-exists=.env src/modules/_lifecycle/scripts/enable.ts",
    "module:disable": "tsx --env-file-if-exists=.env src/modules/_lifecycle/scripts/disable.ts",
    "module:status": "tsx --env-file-if-exists=.env src/modules/_lifecycle/scripts/status.ts",
    "i18n:coverage": "tsx --env-file-if-exists=.env src/modules/_i18n/scripts/coverage.ts",
    "i18n:reload": "tsx --env-file-if-exists=.env src/modules/_i18n/scripts/reload.ts",
    "i18n:hardcoded": "tsx scripts/i18n-hardcoded-strings.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-s3": "^3.1042.0",
    "@aws-sdk/s3-request-presigner": "^3.1042.0",
    "@b2b/cms-components": "workspace:^",
    "@b2b/contracts": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/type-provider-zod": "^1.0.0",
    "@google-cloud/storage": "^7.19.0",
    "@mikro-orm/core": "^6.6.13",
    "@mikro-orm/migrations": "^6.6.13",
    "@mikro-orm/postgresql": "^6.6.13",
    "argon2": "^0.44.0",
    "bullmq": "^5.76.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "file-type": "^22.0.1",
    "ioredis": "^5.10.1",
    "meilisearch": "^0.57.0",
    "nodemailer": "^7.0.9",
    "openapi-types": "^12.1.3",
    "openid-client": "^6.8.4",
    "otpauth": "^9.5.0",
    "pdfmake": "^0.3.7",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "read-excel-file": "^9.0.9",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.6.13",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfmake": "^0.3.2",
    "@types/pg": "^8.20.0",
    "aws-sdk-client-mock": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/db/mikro-orm.config.ts",
      "./dist/db/mikro-orm.config.js"
    ]
  }
}
