# Documentation site (Docusaurus) development environment.
# Copy to docs/.env before running `pnpm --filter docs run dev`.

# PORT — Docusaurus dev/start port. Loaded via Node's
# `--env-file-if-exists=.env` flag in package.json's `dev` and `start`
# scripts (Docusaurus respects PORT through webpack-dev-server when
# `--port` is not passed).
PORT=3003

# DEEPL_API_KEY — DeepL API key for maintainer-only docs translation
# (`pnpm --filter backend run docs:translate`). Never required for CI or
# `pnpm --filter docs run build`; Polish content comes from committed cache
# and i18n files. Copy your key from https://www.deepl.com/pro-api and set
# it in docs/.env (gitignored) or backend/.env when running translate locally.
# DEEPL_API_KEY=
