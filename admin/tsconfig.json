{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client", "react"],
    "baseUrl": ".",
    "paths": {
      "@endora-commerce/contracts": ["../packages/contracts/src/index.ts"],
      "@endora-commerce/contracts/*": ["../packages/contracts/src/*"],
      "@endora-commerce/admin-shell": ["../packages/admin-shell/src/index.ts"],
      "@endora-commerce/admin-shell/*": ["../packages/admin-shell/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
