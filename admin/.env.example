# Admin panel development environment — safe defaults for the Docker Compose stack.
# Copy to admin/.env before running `pnpm --filter admin run dev`.

# PORT — Vite dev/preview port. Read by vite.config.ts via `loadEnv`.
PORT=3002

# Backend host without an /api/v1 suffix — the api-client appends the full path.
VITE_API_BASE_URL=http://localhost:3001

# Storefront origin — used to absolutize product/category links baked into emails.
VITE_STOREFRONT_BASE_URL=http://localhost:3000
