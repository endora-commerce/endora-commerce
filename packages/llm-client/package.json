{
  "name": "@endora-commerce/llm-client",
  "version": "0.109.0",
  "type": "module",
  "description": "Provider-neutral LLM transport — fetch-based Anthropic, Google and OpenAI (and OpenAI-compatible) adapters with tool calling, shared by the modules that call a language model.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endora-commerce/endora-commerce.git",
    "directory": "packages/llm-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs --src src --out dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@endora-commerce/contracts": "workspace:*",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
