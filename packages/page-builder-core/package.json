{
  "name": "@endora-commerce/page-builder-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Page Builder primitives — responsive props, context filtering, and component definition helpers for CMS, email, and invoice builders.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./editor/carousel-preview": {
      "types": "./dist/editor/editor-carousel-preview.d.ts",
      "default": "./dist/editor/editor-carousel-preview.js"
    },
    "./editor/puck-guards": {
      "types": "./dist/editor/puck-action-guards.d.ts",
      "default": "./dist/editor/puck-action-guards.js"
    },
    "./editor/use-page-builder-puck": {
      "types": "./dist/editor/use-page-builder-puck.d.ts",
      "default": "./dist/editor/use-page-builder-puck.js"
    },
    "./fields/hide-on-field": {
      "types": "./dist/fields/hide-on-field.d.ts",
      "default": "./dist/fields/hide-on-field.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./types/responsive": {
      "types": "./dist/types/responsive.d.ts",
      "default": "./dist/types/responsive.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@measured/puck": "*",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@measured/puck": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@measured/puck": "*",
    "@types/react": "^19.2.14",
    "react": "^19.2.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  }
}
