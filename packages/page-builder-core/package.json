{
  "name": "@b2b/page-builder-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Page Builder primitives — responsive props, context filtering, and component definition helpers for CMS, email, and invoice builders.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./editor": "./src/editor.ts",
    "./editor/carousel-preview": "./src/editor/editor-carousel-preview.ts",
    "./editor/puck-guards": "./src/editor/puck-action-guards.ts",
    "./editor/use-page-builder-puck": "./src/editor/use-page-builder-puck.ts",
    "./fields/hide-on-field": "./src/fields/hide-on-field.tsx",
    "./client": "./src/client.ts",
    "./types/responsive": "./src/types/responsive.ts",
    "./*": "./src/*.ts"
