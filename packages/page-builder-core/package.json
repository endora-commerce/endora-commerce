      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@measured/puck": "*",
    "@types/react": "^19.2.14",
    "react": "^19.2.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  }
}
