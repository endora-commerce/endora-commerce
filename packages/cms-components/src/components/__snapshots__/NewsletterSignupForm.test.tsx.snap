// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`newsletter.Signup subscriber attributes (feature 169, T176) > without attributes, a stored block renders the markup of before 1`] = `"<div><div class="cmsc-pb-hide-on" data-hide-mobile="0" data-hide-tablet="0" data-hide-desktop="0" data-pb-editing="0"><section class="cmsc-section" id="signup" data-width="contained" style="--cmsc-section-pt:var(--cmsb-space-l, 40px);--cmsc-section-pt-md:var(--cmsb-space-l, 40px);--cmsc-section-pt-lg:var(--cmsb-space-l, 64px);--cmsc-section-pb:var(--cmsb-space-l, 40px);--cmsc-section-pb-md:var(--cmsb-space-l, 40px);--cmsc-section-pb-lg:var(--cmsb-space-l, 64px)"><div class="cmsc-section__frame"><div><div class="cmsc-pb-hide-on" data-hide-mobile="0" data-hide-tablet="0" data-hide-desktop="0" data-pb-editing="0"><div class="cmsc-pb-signup cmsc-pb-signup--inline"><h2 class="cmsc-pb-block-heading cmsc-pb-signup__heading cmsc-t--h3">Stay in the loop</h2><div class="cmsc-pb-signup__text cmsc-pb-rich"><p>News, offers and events, a few times a month.</p></div><form class="cmsc-pb-signup__form" action="/newsletter/subscribe" method="post"><input type="hidden" name="returnTo" value="/landing"/><input type="hidden" name="anchor" value="signup"/><input type="hidden" name="topicsRequired" value="on"/><div class="cmsc-pb-signup__row"><div class="cmsc-pb-signup__field"><label class="cmsc-pb-signup__label" for="pb-signup-signup-1-email">E-mail address</label><input id="pb-signup-signup-1-email" class="cmsc-pb-signup__input" type="email" autoComplete="email" required="" placeholder="you@example.com" name="email"/></div><button type="submit" class="cmsc-pb-signup__button">Sign up</button></div><fieldset class="cmsc-pb-signup__topics"><legend class="cmsc-pb-signup__legend">Topics</legend><div class="cmsc-pb-signup__check"><input id="pb-signup-signup-1-topic-0" type="checkbox" name="topics" value="offers"/><label for="pb-signup-signup-1-topic-0">Offers</label></div><div class="cmsc-pb-signup__check"><input id="pb-signup-signup-1-topic-1" type="checkbox" name="topics" value="events"/><label for="pb-signup-signup-1-topic-1">Events</label></div></fieldset><div class="cmsc-pb-signup__consent cmsc-pb-signup__check"><input id="pb-signup-signup-1-consent" type="checkbox" required="" name="consent" value="on"/><label for="pb-signup-signup-1-consent">I accept the <a href="/privacy-policy">privacy policy</a></label></div><p class="cmsc-pb-signup__message" role="status" aria-live="polite"></p></form></div></div></div></div></section></div></div>"`;
