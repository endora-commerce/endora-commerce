{
  "name": "@b2b/cms-components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared CMS Page Builder components — runtime contract between admin (editor) and storefront (renderer). Per Principle I, this is the canonical workspace home for the React components that Puck composes; backend modules contribute additional component types via the registry SPI in backend/src/modules/cms/services/page-builder-registry.ts.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/cms-components.css",
    "./*": "./src/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./schema/*": "./src/schema/*.ts"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tailwindcss -i styles/cms-components.css -o dist/cms-components.css --minify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@b2b/page-builder-core": "workspace:^",
    "@measured/puck": "*",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-text-align": "3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-text-align": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    }
  },
  "dependencies": {
    "lucide-react": "^1.11.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@b2b/page-builder-core": "workspace:^",
    "@tailwindcss/cli": "4",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-color": "3.22.5",
    "@tiptap/extension-highlight": "3.22.5",
    "@tiptap/extension-image": "3.22.5",
    "@tiptap/extension-text-align": "3.22.5",
    "@tiptap/extension-text-style": "3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "leaflet": "^1.9.4",
    "react-dom": "^19.2.5",
    "tailwindcss": "4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  }
}
