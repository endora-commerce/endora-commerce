{
  "name": "@endora-commerce/cms-components",
  "version": "0.100.2",
  "type": "module",
  "description": "Shared CMS Page Builder components — runtime contract between admin (editor) and storefront (renderer). Per Principle I, this is the canonical workspace home for the React components that Puck composes; backend modules contribute additional component types via the registry SPI in backend/src/modules/cms/services/page-builder-registry.ts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endora-commerce/endora-commerce.git",
    "directory": "packages/cms-components"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/cms-components.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./schema/*": {
      "types": "./dist/schema/*.d.ts",
      "default": "./dist/schema/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tailwindcss -i styles/cms-components.css -o dist/cms-components.css --minify",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@endora-commerce/page-builder-core": "workspace:^",
    "@measured/puck": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-color": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.11.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@endora-commerce/page-builder-core": "workspace:^",
    "@tailwindcss/cli": "4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react-dom": "^19.2.5",
    "tailwindcss": "4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
