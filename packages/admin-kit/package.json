{
  "name": "@endora-commerce/admin-kit",
  "version": "0.9.7",
  "type": "module",
  "endora": {
    "type": "admin-ui"
  },
  "description": "The admin surface a module package's ./admin layer is written against (feature 091). Publishes the contribution declaration types, the host-side zone renderer, the four design-system subpaths — ./ui, ./components, ./lib and ./i18n — whose members are derived from what admin module code actually imports, and ./theme.css, the host design system every renderer resolves against (D-219).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endora-commerce/endora-commerce.git",
    "directory": "packages/admin-kit"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./contributions": {
      "types": "./dist/contributions/index.d.ts",
      "default": "./dist/contributions/index.js"
    },
    "./zones": {
      "types": "./dist/zones/index.d.ts",
      "default": "./dist/zones/index.js"
    },
    "./field-protection": {
      "types": "./dist/field-protection/index.d.ts",
      "default": "./dist/field-protection/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    "./theme.css": "./theme.css",
    "./tailwind.css": "./tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tailwind.css",
    "theme.css"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@endora-commerce/contracts": "workspace:*",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.11.0",
    "react": "^19.0.0",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@endora-commerce/contracts": "workspace:*",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/react": "^19.2.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}
