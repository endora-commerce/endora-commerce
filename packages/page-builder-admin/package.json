{
  "name": "@endora-commerce/page-builder-admin",
  "version": "0.8.2",
  "type": "module",
  "endora": {
    "type": "admin-ui"
  },
  "description": "The admin-side page-builder chrome and the e-mail builder (feature 091, P5b; D-192). `.` is the editor chrome `cms`, `blog` and `invoices` render — header actions, asset and catalog field factories, the colour palette, the overlay bridge and the action-bar target — which named `cms` nowhere and lived there only because `cms` was the first builder written. `./email` is the e-mail builder those same primitives compose, which `newsletter` and `transactional_emails` render. A fourth member of the `page-builder` family, in D-108's one `linked` group.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.endora.pl/b2b-platform-ai/monorepo.git",
    "directory": "packages/page-builder-admin"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    },
    "./tailwind.css": "./tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tailwind.css"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@endora-commerce/admin-kit": "workspace:*",
    "@endora-commerce/cms-components": "workspace:^",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/email-components": "workspace:^",
    "@endora-commerce/page-builder-core": "workspace:^",
    "@measured/puck": "*",
    "lucide-react": "^1.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@endora-commerce/admin-kit": "workspace:*",
    "@endora-commerce/cms-components": "workspace:^",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/email-components": "workspace:^",
    "@endora-commerce/page-builder-core": "workspace:^",
    "@measured/puck": "^0.20.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}
