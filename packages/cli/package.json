{
  "name": "@endora-commerce/cli",
  "version": "0.14.0",
  "type": "module",
  "description": "The `endora` command line: scaffolding and conformance tooling for Endora Commerce modules and integrations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.endora.pl/b2b-platform-ai/monorepo.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "endora": "./dist/bin/endora.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib/*.js": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./rules/*.js": {
      "types": "./dist/rules/*.d.ts",
      "default": "./dist/rules/*.js"
    },
    "./checks": {
      "types": "./dist/checks.d.ts",
      "default": "./dist/checks.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@endora-commerce/contracts": "workspace:*",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "vitest": "^2.1.4"
  }
}
