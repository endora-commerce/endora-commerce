{
  "name": "@endora-commerce/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The `endora` command line: scaffolding and conformance tooling for Endora Commerce modules and integrations.",
  "bin": {
    "endora": "./dist/bin/endora.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@endora-commerce/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  }
}
