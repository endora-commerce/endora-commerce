{
  "name": "@b2b/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Source-of-truth Zod schemas shared across backend, storefront, admin (Principle V). The backend regenerates its live OpenAPI document from these at startup.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  }
}
