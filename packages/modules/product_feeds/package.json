{
  "name": "@endora-commerce/mod-product-feeds",
  "version": "0.9.5",
  "type": "module",
  "sideEffects": false,
  "description": "Publishes the catalogue of a sales channel as a provider-shaped feed file (Google Merchant Center, Meta, Amazon, eBay, Allegro) at a stable tokenised URL, on a per-feed schedule.",
  "license": "MIT",
  "endora": {
    "type": "module",
    "id": "product_feeds"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.endora.pl/b2b-platform-ai/monorepo.git",
    "directory": "packages/modules/product_feeds"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "default": "./dist/backend/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./dist/migrations/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./tailwind.css": "./tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "i18n",
    "docs",
    "tailwind.css"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../../scripts/copy-package-assets.mjs --src src --out dist && tsc -p tsconfig.ui.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@endora-commerce/admin-kit": "workspace:*",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@fastify/rate-limit": "^10",
    "@mikro-orm/core": "^6",
    "@mikro-orm/migrations": "^6",
    "@mikro-orm/postgresql": "^6",
    "@types/ssh2-sftp-client": "^9",
    "basic-ftp": "^6",
    "bullmq": "^5",
    "exceljs": "^4",
    "fastify": "^5",
    "ioredis": "^5",
    "lucide-react": "^1",
    "react": "^19",
    "react-router-dom": "^7",
    "ssh2-sftp-client": "^12",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "@endora-commerce/admin-kit": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@endora-commerce/admin-kit": "workspace:*",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@fastify/rate-limit": "^10.3.0",
    "@mikro-orm/core": "^6.6.13",
    "@mikro-orm/migrations": "^6.6.13",
    "@mikro-orm/postgresql": "^6.6.13",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/ssh2-sftp-client": "^9.0.6",
    "basic-ftp": "^6.2.0",
    "bullmq": "^5.76.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "ssh2-sftp-client": "^12.1.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4",
    "zod": "^4.2.0"
  }
}
