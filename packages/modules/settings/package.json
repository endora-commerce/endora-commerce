{
  "name": "@endora-commerce/mod-settings",
  "version": "0.9.7",
  "type": "module",
  "sideEffects": false,
  "description": "Per-module setting registry, admin UI, and value resolver.",
  "license": "MIT",
  "endora": {
    "type": "module",
    "id": "settings"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.endora.pl/b2b-platform-ai/monorepo.git",
    "directory": "packages/modules/settings"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "default": "./dist/backend/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./tailwind.css": "./tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "i18n",
    "docs",
    "tailwind.css"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.ui.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@endora-commerce/admin-kit": "workspace:*",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/mod-credentials": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@fastify/rate-limit": "^10",
    "@mikro-orm/postgresql": "^6",
    "fastify": "^5",
    "ioredis": "^5",
    "lucide-react": "^1",
    "react": "^19",
    "react-router-dom": "^7"
  },
  "peerDependenciesMeta": {
    "@endora-commerce/admin-kit": {
      "optional": true
    },
    "@endora-commerce/mod-credentials": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@endora-commerce/admin-kit": "workspace:*",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/mod-credentials": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@fastify/rate-limit": "^10.3.0",
    "@mikro-orm/postgresql": "^6.6.13",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "typescript": "^5.9.3"
  }
}
