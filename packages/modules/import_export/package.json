{
  "name": "@endora-commerce/mod-import-export",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Bulk product import and export wizard.",
  "endora": {
    "type": "module",
    "id": "import_export"
  },
  "exports": {
    ".": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "default": "./dist/backend/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "i18n"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "fastify": "^5"
  },
  "devDependencies": {
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@types/node": "^22.9.0",
    "fastify": "^5.8.5",
    "typescript": "^5.9.3"
  }
}
