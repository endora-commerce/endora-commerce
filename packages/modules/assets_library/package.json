{
  "name": "@endora-commerce/mod-assets-library",
  "version": "0.10.1",
  "type": "module",
  "sideEffects": false,
  "description": "Storage adapter registry (local / S3 / GCS), asset upload, and reference tracking.",
  "license": "MIT",
  "endora": {
    "type": "module",
    "id": "assets_library"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.endora.pl/b2b-platform-ai/monorepo.git",
    "directory": "packages/modules/assets_library"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "default": "./dist/backend/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./dist/migrations/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./tailwind.css": "./tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "i18n",
    "docs",
    "tailwind.css"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.ui.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@endora-commerce/admin-kit": "workspace:*",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@fastify/multipart": "^10",
    "@google-cloud/storage": "^7",
    "@mikro-orm/core": "^6",
    "@mikro-orm/migrations": "^6",
    "@mikro-orm/postgresql": "^6",
    "fastify": "^5",
    "file-type": "^22",
    "lucide-react": "^1",
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "@endora-commerce/admin-kit": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1042.0",
    "@aws-sdk/s3-request-presigner": "^3.1042.0",
    "@endora-commerce/admin-kit": "workspace:*",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@fastify/multipart": "^10.0.0",
    "@google-cloud/storage": "^7.19.0",
    "@mikro-orm/core": "^6.6.13",
    "@mikro-orm/migrations": "^6.6.13",
    "@mikro-orm/postgresql": "^6.6.13",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "fastify": "^5.8.5",
    "file-type": "^22.0.1",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  }
}
