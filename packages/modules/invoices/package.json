{
  "name": "@endora-commerce/mod-invoices",
  "version": "0.11.1",
  "type": "module",
  "sideEffects": false,
  "description": "Invoice generation, numbering, PDF templates, corrections, and email delivery.",
  "license": "MIT",
  "endora": {
    "type": "module",
    "id": "invoices"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endora-commerce/endora-commerce.git",
    "directory": "packages/modules/invoices"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "default": "./dist/backend/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./dist/migrations/index.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "default": "./dist/ports/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./tailwind.css": "./tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "i18n",
    "docs",
    "tailwind.css"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.ui.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@endora-commerce/admin-kit": "workspace:*",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/email-components": "workspace:*",
    "@endora-commerce/page-builder-admin": "workspace:*",
    "@endora-commerce/page-builder-core": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@measured/puck": "^0",
    "@mikro-orm/core": "^6",
    "@mikro-orm/migrations": "^6",
    "@mikro-orm/postgresql": "^6",
    "@types/pdfmake": "^0",
    "fastify": "^5",
    "lucide-react": "^1",
    "pdfmake": "^0",
    "react": "^19",
    "react-router-dom": "^7",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "@endora-commerce/admin-kit": {
      "optional": true
    },
    "@endora-commerce/page-builder-admin": {
      "optional": true
    },
    "@measured/puck": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@endora-commerce/admin-kit": "workspace:*",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/email-components": "workspace:*",
    "@endora-commerce/page-builder-admin": "workspace:*",
    "@endora-commerce/page-builder-core": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@fastify/type-provider-zod": "^1.0.0",
    "@measured/puck": "^0.20.2",
    "@mikro-orm/core": "^6.6.13",
    "@mikro-orm/migrations": "^6.6.13",
    "@mikro-orm/postgresql": "^6.6.13",
    "@types/node": "^22.9.0",
    "@types/pdfmake": "^0.3.2",
    "@types/react": "^19.2.14",
    "fastify": "^5.8.5",
    "lucide-react": "^1.11.0",
    "pdfmake": "^0.3.7",
    "react": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4",
    "zod": "^4.2.0"
