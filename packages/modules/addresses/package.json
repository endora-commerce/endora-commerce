{
  "name": "@endora-commerce/mod-addresses",
  "version": "0.112.0",
  "type": "module",
  "sideEffects": false,
  "description": "Reusable address entities used by organizations, customers, and order fulfilment.",
  "license": "MIT",
  "endora": {
    "type": "module",
    "id": "addresses"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endora-commerce/endora-commerce.git",
    "directory": "packages/modules/addresses"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "default": "./dist/backend/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "i18n",
    "docs",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node ../../../scripts/clean-package-dist.mjs --src src --out dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@mikro-orm/core": "^7.2.11",
    "@mikro-orm/decorators": "^7.2.11",
    "@mikro-orm/postgresql": "^7.2.11"
  },
  "devDependencies": {
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@endora-commerce/test-kit": "workspace:*",
    "@mikro-orm/core": "^7.2.11",
    "@mikro-orm/decorators": "^7.2.11",
    "@mikro-orm/postgresql": "^7.2.11",
    "@types/node": "^22.9.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
