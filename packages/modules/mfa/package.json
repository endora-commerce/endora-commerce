{
  "name": "@endora-commerce/mod-mfa",
  "version": "0.112.0",
  "type": "module",
  "sideEffects": false,
  "description": "Two-factor authentication (TOTP + recovery codes) and Google/Microsoft sign-in, with per-scope enablement/enforcement and admin reset.",
  "license": "MIT",
  "endora": {
    "type": "module",
    "id": "mfa"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endora-commerce/endora-commerce.git",
    "directory": "packages/modules/mfa"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "default": "./dist/backend/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./dist/migrations/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./tailwind.css": "./tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "i18n",
    "docs",
    "tailwind.css",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node ../../../scripts/clean-package-dist.mjs --src src --out dist && tsc -p tsconfig.build.json && tsc -p tsconfig.ui.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@endora-commerce/admin-kit": "workspace:*",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@fastify/cookie": "^11",
    "@mikro-orm/core": "^7.2.11",
    "@mikro-orm/decorators": "^7.2.11",
    "@mikro-orm/migrations": "^7.2.11",
    "@mikro-orm/postgresql": "^7.2.11",
    "fastify": "^5.11.0",
    "ioredis": "^5",
    "lucide-react": "^1",
    "openid-client": "^6",
    "otpauth": "^9",
    "react": "^19",
    "react-router-dom": "^7",
    "uqr": "^0",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "@endora-commerce/admin-kit": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@endora-commerce/admin-kit": "workspace:*",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/type-provider-zod": "^1.0.0",
    "@mikro-orm/core": "^7.2.11",
    "@mikro-orm/decorators": "^7.2.11",
    "@mikro-orm/migrations": "^7.2.11",
    "@mikro-orm/postgresql": "^7.2.11",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "fastify": "^5.12.8",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.11.0",
    "openid-client": "^6.8.4",
    "otpauth": "^9.5.0",
    "react": "^19.2.5",
    "react-router-dom": "^7.18.2",
    "typescript": "^5.9.3",
    "uqr": "^0.1.3",
    "vitest": "^4.1.12",
    "zod": "^4.2.0"
  }
}
