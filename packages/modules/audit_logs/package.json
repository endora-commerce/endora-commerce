{
  "name": "@endora-commerce/mod-audit-logs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Append-only audit log for sensitive admin and customer actions.",
  "endora": {
    "type": "module",
    "id": "audit_logs"
  },
  "exports": {
    ".": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "default": "./dist/backend/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@mikro-orm/postgresql": "^6",
    "fastify": "^5",
    "zod": "^4"
  },
  "devDependencies": {
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@mikro-orm/postgresql": "^6.6.13",
    "@types/node": "^22.9.0",
    "fastify": "^5.8.5",
    "typescript": "^5.9.3",
    "zod": "^4.2.0"
  }
}
