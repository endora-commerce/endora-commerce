{
  // Emit configuration — the only configuration in this package allowed to write
  // files, and the declaration the composer reads to learn where this package's
  // sources end up (`backend/scripts/lib/module-packages.ts`).
  //
  // `paths` is cleared, so `@endora-commerce/contracts` resolves through its own
  // `exports` map to its built `.d.ts`; `pnpm run build:packages` builds
  // `contracts` and `platform` before this package, which is what makes that
  // resolution real. `rootDir` with an active `paths` block is the TS6059 trap:
  // `tsc` reports the sibling's source as outside `rootDir`, exits 2, and emits
  // that sibling's `.js`/`.d.ts` beside its source anyway.
  //
  // The artefact format is the package format, not a per-package judgement
  // (D-164): `manifests:generate` derives every `exports` target from this
  // file's `rootDir`/`outDir`, so a source-shipping module package is not
  // expressible. With eighteen decorated entity classes — the most of any module
  // in the tree — this package is the case D-164 measured at its widest: under
  // `tsx` a source-shipped entity is lowered with standard decorator semantics
  // while MikroORM's are legacy, and it dies at load.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {},
    "rootDir": "./src",
    "noEmit": false,
    // A compile that failed must ship nothing (feature 080, R11). Without this a
    // diagnostic is not a stop — the artefacts are written before the exit code is.
    "noEmitOnError": true
  },
  // Test files are excluded from the emit and from nothing else. A compiled
  // `*.test.js` under `dist` imports `vitest`, a devDependency, so it would be an
  // unresolvable specifier in every consumer's install. The exclusion lives here
  // rather than in `tsconfig.json` because that file is the type-check half, and
  // a test excluded there is a test no `tsc` invocation reads (issue #81).
  // `exclude` replaces the inherited list rather than extending it, so the UI
  // directories `tsconfig.json` keeps out of this program are restated.
  "exclude": ["src/admin/**/*", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
