{
  "name": "@endora-commerce/mod-cms",
  "version": "0.104.0",
  "type": "module",
  "sideEffects": false,
  "description": "Pages, blocks, templates, and hooks for content management.",
  "license": "MIT",
  "endora": {
    "type": "module",
    "id": "cms"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endora-commerce/endora-commerce.git",
    "directory": "packages/modules/cms"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "default": "./dist/backend/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./dist/migrations/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./admin-ui": {
      "types": "./dist/admin-ui/index.d.ts",
      "default": "./dist/admin-ui/index.js"
    },
    "./tailwind.css": "./tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "i18n",
    "docs",
    "tailwind.css"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.ui.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@endora-commerce/admin-kit": "workspace:*",
    "@endora-commerce/cms-components": "workspace:*",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/page-builder-admin": "workspace:*",
    "@endora-commerce/page-builder-core": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@mikro-orm/core": "^6",
    "@mikro-orm/migrations": "^6",
    "@mikro-orm/postgresql": "^6",
    "@puckeditor/core": "^0",
    "fastify": "^5.11.0",
    "ioredis": "^5",
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "@endora-commerce/admin-kit": {
      "optional": true
    },
    "@endora-commerce/cms-components": {
      "optional": true
    },
    "@endora-commerce/page-builder-admin": {
      "optional": true
    },
    "@puckeditor/core": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@endora-commerce/admin-kit": "workspace:*",
    "@endora-commerce/cms-components": "workspace:*",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/page-builder-admin": "workspace:*",
    "@endora-commerce/page-builder-core": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@mikro-orm/core": "^6.6.13",
    "@mikro-orm/migrations": "^6.6.13",
    "@mikro-orm/postgresql": "^6.6.13",
    "@puckeditor/core": "^0.23.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "fastify": "^5.12.5",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.2.0"
  }
}
