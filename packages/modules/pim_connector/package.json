{
  "name": "@endora-commerce/mod-pim-connector",
  "version": "0.7.2",
  "type": "module",
  "sideEffects": false,
  "description": "Shared operator behaviours for PIM connectors: mutual exclusion, run/issue vocabulary and field-protection path grammar.",
  "license": "MIT",
  "endora": {
    "type": "module",
    "id": "pim_connector"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.endora.pl/b2b-platform-ai/monorepo.git",
    "directory": "packages/modules/pim_connector"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "default": "./dist/backend/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./dist/migrations/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "i18n"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@mikro-orm/core": "^6",
    "@mikro-orm/migrations": "^6",
    "@mikro-orm/postgresql": "^6"
  },
  "devDependencies": {
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@mikro-orm/core": "^6.6.13",
    "@mikro-orm/migrations": "^6.6.13",
    "@mikro-orm/postgresql": "^6.6.13",
    "@types/node": "^22.9.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  }
}
