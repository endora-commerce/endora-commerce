{
  "name": "@endora-commerce/mod-admin-feedback",
  "version": "0.109.0",
  "type": "module",
  "sideEffects": false,
  "description": "Send feedback from the admin to the makers of Endora Commerce: a message, a contact address and what the instance knows about itself, relayed as one e-mail and stored nowhere.",
  "license": "MIT",
  "endora": {
    "type": "module",
    "id": "admin_feedback"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endora-commerce/endora-commerce.git",
    "directory": "packages/modules/admin_feedback"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "default": "./dist/backend/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "i18n",
    "docs"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node ../../../scripts/clean-package-dist.mjs --src src --out dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@fastify/rate-limit": "^10",
    "fastify": "^5.11.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@fastify/rate-limit": "^10.3.0",
    "@types/node": "^22.9.0",
    "fastify": "^5.12.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.2.0"
  }
}
