{
  "name": "@endora-commerce/mod-blog",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "The Blog module as a package (feature 080, T040b) — the first module to leave backend/src/modules. Ships compiled output (D-164); the manifest id 'blog' stays identity of record everywhere (D-142).",
  "endora": {
    "type": "module",
    "id": "blog"
  },
  "exports": {
    ".": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "default": "./dist/backend/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./dist/migrations/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "i18n",
    "docs"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.ui.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@endora-commerce/admin-kit": "workspace:*",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/mod-cms": "workspace:*",
    "@endora-commerce/page-builder-core": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@measured/puck": "^0",
    "@mikro-orm/core": "^6",
    "@mikro-orm/migrations": "^6",
    "@mikro-orm/postgresql": "^6",
    "fastify": "^5",
    "ioredis": "^5",
    "react": "^19",
    "react-router-dom": "^7",
    "vitest": "^2",
    "zod": "^4"
  },
  "devDependencies": {
    "@endora-commerce/admin-kit": "workspace:*",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/mod-cms": "workspace:*",
    "@endora-commerce/page-builder-core": "workspace:*",
    "@endora-commerce/platform": "workspace:*",
    "@measured/puck": "^0.20.2",
    "@mikro-orm/core": "^6.6.13",
    "@mikro-orm/migrations": "^6.6.13",
    "@mikro-orm/postgresql": "^6.6.13",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "react": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4",
    "zod": "^4.2.0"
  }
}
