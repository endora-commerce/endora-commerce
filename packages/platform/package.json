{
  "name": "@endora-commerce/platform",
  "version": "0.12.0",
  "type": "module",
  "sideEffects": false,
  "endora": {
    "type": "platform"
  },
  "description": "The host package (feature 080, T042a). Publishes the surface an installed extension package compiles against: five enumerated subpaths, one per platform directory that has published API. No root export and no wildcard (D-160.7). The remaining subpaths are host-internal and no module may name any of them (D-160.14) — how many that is is not written here, `HOST_INTERNAL_SUBPATHS` in packages/cli/src/lib/platform-surface.ts carries one reason per member and this sentence read 'three' over six of them: ./composition, the host composition surface; ./db, the ORM configuration, the migration ordering and the bootstrap (specs/110-instance-repository/, T116); ./migrations, the platform's own twelve migrations and the frozen historical prefix an execution order is computed from (specs/110-instance-repository/, R1.5); ./lifecycle, the operator surface that drives the platform presence axis (specs/115-lifecycle-container-move/, D115-4); ./env, the environment inputs the host reads; ./packages, installed extension-package discovery; ./overlay, the loader that composes a deployment's client-only modules (specs/110-instance-repository/, T113 and T114); ./cli, the host's side of a module-declared operator command (T117); and ./demo, the demo-data guard, plan, runner and report (feature 113, T119b).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.endora.pl/b2b-platform-ai/monorepo.git",
    "directory": "packages/platform"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "default": "./dist/kernel/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./tenancy": {
      "types": "./dist/tenancy/index.d.ts",
      "default": "./dist/tenancy/index.js"
    },
    "./commands": {
      "types": "./dist/commands/index.d.ts",
      "default": "./dist/commands/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    },
    "./composition": {
      "types": "./dist/composition/index.d.ts",
      "default": "./dist/composition/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./dist/migrations/index.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle/index.d.ts",
      "default": "./dist/lifecycle/index.js"
    },
    "./env": {
      "types": "./dist/env/index.d.ts",
      "default": "./dist/env/index.js"
    },
    "./packages": {
      "types": "./dist/packages/index.d.ts",
      "default": "./dist/packages/index.js"
    },
    "./overlay": {
      "types": "./dist/overlay/index.d.ts",
      "default": "./dist/overlay/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./demo": {
      "types": "./dist/demo/index.d.ts",
      "default": "./dist/demo/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-package-assets.mjs --src src --out dist",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@endora-commerce/contracts": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/type-provider-zod": "^1.0.0",
    "argon2": "^0.44.0",
    "awilix": "^13.0.5",
    "bullmq": "^5.76.1",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.10.1",
    "openapi-types": "^12.1.3",
    "pino": "^10.3.1"
  },
  "peerDependencies": {
