{
  "name": "@endora-commerce/platform",
  "version": "0.7.0",
  "type": "module",
  "sideEffects": false,
  "endora": {
    "type": "platform"
  },
  "description": "The host package (feature 080, T042a). Publishes the surface an installed extension package compiles against: five enumerated subpaths, one per platform directory that has published API. No root export and no wildcard (D-160.7). Two further subpaths are host-internal and no module may name either (D-160.14): ./composition, the host composition surface, and ./migrations, the frozen historical prefix an execution order is computed from (specs/110-instance-repository/, R1.5).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.endora.pl/b2b-platform-ai/monorepo.git",
    "directory": "packages/platform"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "default": "./dist/kernel/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./tenancy": {
      "types": "./dist/tenancy/index.d.ts",
      "default": "./dist/tenancy/index.js"
    },
    "./commands": {
      "types": "./dist/commands/index.d.ts",
      "default": "./dist/commands/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    },
    "./composition": {
      "types": "./dist/composition/index.d.ts",
      "default": "./dist/composition/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./dist/migrations/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-package-assets.mjs --src src --out dist",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@endora-commerce/contracts": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/type-provider-zod": "^1.0.0",
    "argon2": "^0.44.0",
    "awilix": "^13.0.5",
    "bullmq": "^5.76.1",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.10.1",
    "openapi-types": "^12.1.3",
    "pino": "^10.3.1"
  },
  "peerDependencies": {
    "@mikro-orm/core": "^6",
    "@mikro-orm/postgresql": "^6",
    "fastify": "^5",
    "zod": "^4"
  },
  "devDependencies": {
    "@mikro-orm/core": "^6.6.13",
    "@mikro-orm/postgresql": "^6.6.13",
    "@types/node": "^22.9.0",
    "fastify": "^5.8.5",
    "typescript": "^5.9.3",
    "zod": "^4.2.0"
  }
}
