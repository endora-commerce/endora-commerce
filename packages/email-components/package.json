{
  "name": "@b2b/email-components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared transactional-email building blocks (feature 047). Pure, React-free render/* + directives/* + tree/* + schema/* + defaults/* are imported by the backend to render email-client-safe HTML and plain text; the React components/* + config.ts power the admin's email-safe Puck editor. The split keeps React out of the backend send path (Principle I/IV).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@measured/puck": "*",
    "@b2b/page-builder-core": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@measured/puck": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@b2b/page-builder-core": "workspace:^",
    "@measured/puck": "*",
    "@types/react": "^19.2.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  }
}
