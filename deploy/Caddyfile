# Caddy reverse proxy — automatic HTTPS (Let's Encrypt) for the three apps.
# Domains + ACME email are injected from the environment by compose.prod.yml.
# DNS A/AAAA records for all three (sub)domains must point at this VPS first.

{
	email {$ACME_EMAIL}
}

# Storefront (Next.js SSR)
{$STOREFRONT_DOMAIN} {
	encode zstd gzip
	reverse_proxy storefront:3000
}

# Admin SPA (nginx static)
{$ADMIN_DOMAIN} {
	encode zstd gzip
	reverse_proxy admin:80
}

# Backend API (Fastify)
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:3001
}
