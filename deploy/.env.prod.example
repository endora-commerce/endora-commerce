# Production env for the single-VPS stack.
#
# Copy to `deploy/.env` ON THE VPS (never commit the real file) and fill in.
# Read by `docker compose --env-file .env -f compose.prod.yml ...`.
#
# Generate every secret freshly per environment:
#   openssl rand -hex 32      # SESSION_COOKIE_SECRET, ASSETS_LIBRARY_HMAC_KEY
#   openssl rand -base64 32   # SETTINGS_SECRET_ENCRYPTION_KEY, MFA_SECRET_ENCRYPTION_KEY, MEILI_MASTER_KEY

# --- Container registry (GitLab) ---
# Full image path WITHOUT the per-app suffix, e.g. registry.gitlab.com/acme/b2b-platform
REGISTRY_IMAGE=registry.gitlab.com/<group>/<project>
# IMAGE_TAG is normally supplied per-deploy by the CD job (commit SHA).
# Set a default here only for manual `up` runs.
IMAGE_TAG=latest

# --- Domains (DNS must already point at this VPS; TLS handled by host nginx) ---
STOREFRONT_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com

# --- Loopback host ports (host nginx proxies the domains above to these) ---
# Keep the 127.0.0.1 bind prefix — these must NOT be reachable from outside the
# VPS. Change only the port numbers if they clash with something else on the
# host, and mirror the change in deploy/nginx.example.conf.
STOREFRONT_HOST_PORT=127.0.0.1:3000
ADMIN_HOST_PORT=127.0.0.1:8080
API_HOST_PORT=127.0.0.1:3001

# --- PostgreSQL ---
POSTGRES_USER=b2b
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=b2b

# --- Meilisearch ---
MEILI_MASTER_KEY=change-me-base64-32

# --- Backend secrets ---
SESSION_COOKIE_SECRET=change-me-hex-32
SETTINGS_SECRET_ENCRYPTION_KEY=change-me-base64-32
MFA_SECRET_ENCRYPTION_KEY=change-me-base64-32
ASSETS_LIBRARY_HMAC_KEY=change-me-hex-32

# --- Sales channels ---
DEFAULT_SALES_CHANNEL_CODE=default
# host=channelCode pairs, comma-separated; empty disables host resolution.
SALES_CHANNEL_HOST_MAP=

# --- Email (optional) ---
# Leave SMTP_URL empty to use the console mailer (no real delivery).
SMTP_URL=
SMTP_FROM=no-reply@example.com

# --- Misc ---
LOG_LEVEL=info
