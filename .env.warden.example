# Warden project environment — copy to `.env` in the repo root when using
# Warden instead of plain `docker compose` (`pnpm run dev:infra`).
#
#   cp .env.warden.example .env
#   warden sign-certificate endora.test
#   warden env up
#
# Mutually exclusive with the Compose-only `.env` from `.env.example`
# (same filename, different purpose). Do not run both stacks at once.

WARDEN_ENV_NAME=endora
WARDEN_ENV_TYPE=local
WARDEN_WEB_ROOT=/

# local type still inherits Warden's default WARDEN_ELASTICHQ=1 — pin off.
WARDEN_ELASTICHQ=0
WARDEN_ELASTICSEARCH=0
WARDEN_OPENSEARCH=0
WARDEN_VARNISH=0
WARDEN_RABBITMQ=0
WARDEN_DB=0
WARDEN_REDIS=0
WARDEN_NGINX=0

TRAEFIK_DOMAIN=endora.test
TRAEFIK_SUBDOMAIN=

# --- Published host ports (apps on the host talk to localhost) -------
POSTGRES_PORT=5432
POSTGRES_USER=b2b
POSTGRES_PASSWORD=b2b
POSTGRES_DB=b2b

REDIS_PORT=6379

MEILISEARCH_PORT=7700
MEILI_MASTER_KEY=devMasterKeyChangeMe

MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
