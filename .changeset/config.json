{
  "$schema": "https://unpkg.com/@changesets/config@4.0.0/schema.json",
  "baseBranch": "master",
  "access": "public",
  "format": "auto",
  "changelog": "@changesets/cli/changelog",
  "commit": false,
  "ignore": [
    "backend",
    "admin",
    "storefront",
    "docs"
  ],
  "fixed": [
    [
      "@endora-commerce/*",
      "create-endora-commerce"
    ]
  ],
  "linked": [],
  "updateInternalDependencies": "patch",
  "privatePackages": {
    "version": true,
    "tag": false
  }
}
