{
  "name": "endora-commerce",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endora-commerce/endora-commerce.git"
  },
  "description": "Endora Commerce — catalog, Quote Requests, cart, checkout, orders, organizations, admin panel, and integration-ready API. See specs/001-b2b-platform-foundation/ for the spec, plan, and tasks.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "build:packages": "pnpm --filter \"./packages/**\" run build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "version:packages": "node scripts/version-packages.mjs",
    "setup": "pnpm run build:packages && pnpm --filter backend run setup",
    "dev:infra": "docker compose up -d",
    "dev:infra:down": "docker compose down",
    "dev:infra:test": "docker compose --profile test up -d --wait postgres-test",
    "dev:infra:test:down": "docker compose --profile test rm --stop --force postgres-test",
    "dev": "node scripts/dev.mjs",
    "dev:parallel": "pnpm --parallel --filter backend --filter storefront --filter admin run dev",
    "check:naming": "bash scripts/check-naming.sh",
    "check:language": "bash scripts/check-language.sh",
    "check:pdfmake-footprint": "bash scripts/check-pdfmake-footprint.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "webpackbar": "^7.0.0",
      "next>postcss": "^8.5.28",
      "@rushstack/node-core-library>ajv": "^8.20.0",
      "uuid@<11.1.1": "^11.1.1",
      "proxy-addr@<2.0.8": "^2.0.8",
      "shell-quote@<1.11.0": "^1.11.0",
      "compression@<1.8.2": "^1.8.2",
      "source-map-js@<1.2.2": "^1.2.2",
      "fast-copy@>=4.0.0 <4.1.0": "4.1.0",
      "tinypool@<2.1.2": "^2.1.2",
      "happy-dom@<21.0.4": "^21.0.4",
      "serialize-javascript@<7.1.3": "^7.1.3",
      "joi@<17.13.9": "^17.13.9",
      "follow-redirects@<1.16.2": "^1.16.2",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "qs@<6.16.1": "^6.16.1",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "fast-uri@>=4.0.0 <4.2.3": "^4.2.3",
      "body-parser@<1.20.9": "^1.20.9",
      "launch-editor@<2.14.2": "^2.14.2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-jsx-a11y>eslint": "10"
      }
    }
  }
}
