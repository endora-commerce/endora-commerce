# docker-compose.yml — local infrastructure overrides.
#
# Copy this file to `.env` (in the repo root) and adjust to avoid port
# clashes when running multiple instances of the B2B Platform on the
# same machine. `.env` is git-ignored.
#
# Prefer Warden instead? Use `.env.warden.example` → `.env` and follow
# docs/docs/operations/warden.md (mutually exclusive with this Compose stack).
#
# Compose auto-namespaces containers and volumes by COMPOSE_PROJECT_NAME
# (default: the directory holding this file). Two checkouts in different
# directories therefore get separate Docker resources automatically.
# Set the variable explicitly only when you want a friendlier label, or
# when two checkouts happen to share the same directory name.

# Project namespace — affects container and volume names.
# Default (when unset): name of the directory holding this file.
# COMPOSE_PROJECT_NAME=b2b-platform

# --- Published host ports (container-side ports are unchanged) -------

# PostgreSQL (default 5432)
POSTGRES_PORT=5432

# Optional: override DB credentials. Must match backend/.env.
# POSTGRES_USER=b2b
# POSTGRES_PASSWORD=b2b
# POSTGRES_DB=b2b

# Redis (default 6379)
REDIS_PORT=6379

# Meilisearch (default 7700)
MEILISEARCH_PORT=7700
# MEILI_MASTER_KEY=devMasterKeyChangeMe

# Mailhog SMTP (default 1025) and Web UI (default 8025)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
