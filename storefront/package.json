{
  "name": "storefront",
  "version": "0.0.0",
  "private": true,
  "description": "B2B platform customer-facing storefront — Next.js App Router, SSR for catalog/category/product pages.",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/.bin/next dev",
