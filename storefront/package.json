    "lint": "eslint app lib",
    "test": "vitest run"
  },
  "dependencies": {
    "@b2b/api-client": "workspace:*",
    "@b2b/cms-components": "workspace:^",
    "@b2b/contracts": "workspace:*",
    "@measured/puck": "^0.20.2",
    "@tailwindcss/postcss": "^4.2.4",
    "next": "^15.5.15",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  }
