{
  "name": "storefront",
  "version": "0.0.0",
  "private": true,
  "description": "B2B platform customer-facing storefront — Next.js App Router, SSR for catalog/category/product pages.",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "pnpm run themes:generate && node --env-file-if-exists=.env ./node_modules/.bin/next dev",
    "build": "pnpm run themes:generate && next build && pnpm run check:themes",
    "themes:generate": "node scripts/generate-themes.mjs",
    "check:themes": "node scripts/check-themes.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib scripts test",
    "test": "vitest run"
  },
  "dependencies": {
    "@endora-commerce/cms-components": "workspace:^",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/page-builder-core": "workspace:^",
    "@measured/puck": "^0.20.2",
    "@stripe/react-stripe-js": "^6.7.0",
    "@stripe/stripe-js": "^9.9.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-color": "3.22.5",
    "@tiptap/extension-highlight": "3.22.5",
    "@tiptap/extension-image": "3.22.5",
    "@tiptap/extension-text-align": "3.22.5",
    "@tiptap/extension-text-style": "3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "leaflet": "^1.9.4",
    "next": "^15.5.15",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.9.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.10",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  }
}
