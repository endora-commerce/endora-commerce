{
  "name": "storefront",
  "version": "0.0.0",
  "private": true,
  "description": "B2B platform customer-facing storefront — Next.js App Router, SSR for catalog/category/product pages.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm run themes:generate && pnpm run blocks:generate && node --env-file-if-exists=.env node_modules/next/dist/bin/next dev",
    "build": "pnpm run themes:generate && pnpm run blocks:generate && next build && pnpm run check:themes",
    "themes:generate": "node scripts/generate-themes.mjs",
    "blocks:generate": "node scripts/generate-blocks.mjs",
    "check:themes": "node scripts/check-themes.mjs",
    "start": "node --env-file-if-exists=.env scripts/start-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib scripts test",
    "test": "vitest run",
    "conformance": "playwright test --config playwright.conformance.config.ts"
  },
  "dependencies": {
    "@endora-commerce/cms-components": "workspace:^",
    "@endora-commerce/contracts": "workspace:*",
    "@endora-commerce/page-builder-core": "workspace:^",
    "@puckeditor/core": "^0.23.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "leaflet": "^1.9.4",
    "next": "^15.5.27",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/eslint-plugin-next": "^15",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.9.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
