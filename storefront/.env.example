# Storefront development environment — safe defaults for the Docker Compose stack.
# Copy to storefront/.env before running `pnpm --filter storefront run dev`.

# PORT — Next.js dev/start port. Auto-loaded by Next from .env / .env.local.
PORT=3000

# Server-side fetcher (lib/api/*) reads BACKEND_BASE_URL — host only, no /api/v1.
BACKEND_BASE_URL=http://localhost:3001
# NEXT_PUBLIC_* vars are exposed to the browser bundle (app/compare/page.tsx).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SALES_CHANNEL_CODE=pl_default
NEXT_PUBLIC_DEFAULT_LOCALE=en-US
