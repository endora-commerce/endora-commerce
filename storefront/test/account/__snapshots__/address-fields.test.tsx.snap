// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AddressForm through AddressFields > renders the same markup as before 1`] = `"<form class="b2b-auth__form" action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)"><input type="hidden" name="returnTo" value="/addresses"/><div id="address-form-error" tabindex="-1" role="alert"></div><div class="b2b-auth__row"><div class="b2b-auth__field"><label for="addr-kind">Type</label><select id="addr-kind" name="kind"><option value="delivery" selected="">Delivery</option><option value="billing">Billing</option></select></div><div class="b2b-auth__field"><label for="addr-recipient">Recipient</label><input id="addr-recipient" required="" maxLength="160" autoComplete="name" placeholder=" " name="recipientName"/></div></div><div class="b2b-auth__field"><label for="addr-street">Street</label><input id="addr-street" required="" maxLength="255" autoComplete="street-address" placeholder=" " name="street"/></div><div class="b2b-auth__row"><div class="b2b-auth__field"><label for="addr-city">City</label><input id="addr-city" required="" maxLength="120" autoComplete="address-level2" placeholder=" " name="city"/></div><div class="b2b-auth__field"><label for="addr-postal">Postal code</label><input id="addr-postal" required="" maxLength="20" autoComplete="postal-code" placeholder=" " name="postalCode"/></div></div><div class="b2b-auth__row"><div class="b2b-auth__field"><label for="addr-country">Country</label><select id="addr-country" name="country" required=""></select></div><div class="b2b-auth__field"><label for="addr-phone">Phone (optional)</label><input id="addr-phone" type="tel" maxLength="32" autoComplete="tel" placeholder=" " name="phone"/></div></div><label><input type="checkbox" name="isDefault" value="true"/> <!-- -->Make this the default address of its type</label><div class="b2b-auth__actions"><button type="submit" aria-live="polite">Add address</button></div></form>"`;
