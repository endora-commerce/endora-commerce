{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "types": ["node", "react"],
    "incremental": true
  },
  "include": ["next-env.d.ts", "app/**/*", "components/**/*", "lib/**/*", "test/**/*"],
  "exclude": ["node_modules", ".next", "out"]
}
