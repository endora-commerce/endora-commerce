# Dependencies
# No trailing slash: `node_modules/` matches directories only, and a worktree
# wired with `scripts/setup-worktree.sh --link` has a *symlinked* root
# node_modules, which git then reports as an untracked file (issue #255).
node_modules
.pnpm-store/

# Build output
dist/
build/
.next/
out/
.turbo/
storybook-static/

# Test & coverage
coverage/
.nyc_output/
*.lcov

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Tailwind module-package source guard (feature 080, T044). The admin and
# storefront suites write a probe carrying an arbitrary-value utility into each
# module package, compile the app's stylesheet and assert it survived. The files
# are removed in a `finally`; this rule is what keeps a killed run from leaving
# one where `git status` — or a later `git add` — would find it.
**/__tailwind-source-probe__*.ts
**/__tailwind-source-probe__*.tsx

# Runtime / caches
.cache/
.vite/
.docusaurus/
.swc/
.tsbuildinfo
*.tsbuildinfo

# Environment & secrets
.env
.env.*
!.env.example
!.env.*.example

# Editor & OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml

# Generated API docs
backend/src/generated/
packages/contracts/src/generated/

# PDFs and uploaded assets (dev only)
uploads/
tmp/
# Local-FS storage adapter for the Assets Library — dev-only blob store.
backend/var/assets/

# Claude Code local agent state (skills/ stays tracked)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Vite transient transpiled-config shadows
*/vite.config.ts.timestamp-*.mjs
*/vite.config.ts.timestamp-*.cjs
*/vite.config.ts.timestamp-*.js
